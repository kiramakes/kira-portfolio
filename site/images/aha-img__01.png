    <div class="animations-css w-embed">
      <style>
.globe :nth-child(1) {
  animation-delay: -3.6s;
}
.globe :nth-child(2) {
  animation-delay: -1.8s;
}
/* ----- Theme Section ----- */
/* Nav Theme */
[data-theme-nav="light"] .header {
  color: var(--light-silver);
}
[data-theme-nav="dark"] .header {
  color: var(--ink-black);
}
/* ----- Logo Navbar ----- */
[data-logo-scroll] {
  cursor: default;
  pointer-events: none;
}
[data-logo-scroll][data-back-to-top-active] {
  cursor: pointer;
  pointer-events: auto;
}
/* ----- Orbit Portfolio ----- */
/* Previous and next Button*/ 
.portfolio-orbit__btn,
.portfolio-orbit__btn-overlay { 
  transition: transform 0.475s cubic-bezier(0.625, 0.05, 0, 1), opacity 0.475s cubic-bezier(0.625, 0.05, 0, 1)
}
.portfolio-orbit__btn:hover .portfolio-orbit__btn-overlay { 
  transform: scale(1.4);
}
.portfolio-orbit__overlay-nav:hover:has(.portfolio-orbit__btn:hover) .portfolio-orbit__btn { 
  opacity: 0.4;
}
.portfolio-orbit__btn:hover { 
  transform: scale(0.85);
  opacity: 1 !important;
}
/* ----- Contact Section ----- */
[data-contact-word] {
  position: absolute;
  top: 50%;
  left: 50%;
  margin: 0;
  font-size: clamp(1.5rem, 3.5vw, 4.5rem);
  font-weight: 400;
  line-height: 1;
  white-space: nowrap;
  color: rgba(255, 255, 255, 0.5);
  opacity: 0;
  filter: blur(0.65rem);
  transform-style: preserve-3d;
  will-change: transform, opacity, filter;
}
/* ----- Underline Links ----- */
[data-underline-link] {
  position: relative;
  text-decoration: none;
}
[data-underline-link]::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: -0.0625em;
  width: 100%;
  height: 0.0625em;
  background-color: currentColor;
  transform: scaleX(0) rotate(0.001deg);
  transform-origin: right;
  transition: transform 0.735s cubic-bezier(0.625, 0.05, 0, 1);
}
@media (hover: hover) and (pointer: fine) {
  [data-hover]:hover [data-underline-link]::before,
  [data-underline-link]:hover::before {
    transform: scaleX(1) rotate(0.001deg);
    transform-origin: left;
  }
}
/* ----- Keyframes ----- */
/* Scale on Hover */
@media (hover: hover) and (pointer: fine) {
  [data-hover="scale"] {
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }
  [data-hover="scale"]:hover {
    transform: scale(0.95);
  }
}
/* Infinite Rotation */
@keyframes rotate-360 {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
[data-loop="rotate"] {
  animation: rotate-360 6s linear infinite;
}
/* Rotating Globe */
@keyframes globe {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}
@keyframes circle1 {
  0% {
    border-radius: 50%;
    box-shadow: inset .1em 0px 0px .08em var(--ink-black);
    width: 100%;
  }
  49% {
    border-radius: 50%;
    box-shadow: inset .1em 0px 0px .08em var(--ink-black);
    background: transparent;
  }
  50% {
    border-radius: 0%;
    width: .175em;
    background: var(--ink-black);
  }
  51% {
    border-radius: 50%;
    box-shadow: inset -.1em 0px 0px .08em var(--ink-black);
    background: transparent;
  }
  100% {
    border-radius: 50%;
    box-shadow: inset -.1em 0px 0px .08em var(--ink-black);
    width: 100%;
  }
}
/* Shimmer Text */
.shimmer-text {
  color: transparent;
  background-color: rgba(0, 0, 0, 0.35);
  background-image: linear-gradient(
    120deg,
    transparent 40%,
    rgba(0, 0, 0, 1) 50%,
    transparent 60%
  );
  background-size: 200% 100%;
  background-clip: text;
  -webkit-background-clip: text;
  animation: shimmer 3s linear infinite;
}
@keyframes shimmer {
  from {
    background-position: 200% 0%;
  }
  to {
    background-position: -200% 0%;
  }
}
</style>
