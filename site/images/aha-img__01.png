    <div class="buttons-css w-embed">
      <style>
:root {
  --button-007-color: var(--white);
  --button-007-color-background: var(--ink-black);
  --button-007-hover-color: var(--white);
  --button-007-hover-color-background: var(--dark-blue);
  --button-007-color-focus: var(--transparent);
  --button-007-border-radius: 2.5em;
  --button-007-padding: 0.75em 1em;
  --button-007-focus-inset: -0.125em;
  --button-007-overflow: clip;
  --button-007-click-scale: 0.955 0.925;
  --button-007-ease-click: cubic-bezier(0.4, 0, 0.2, 1);
  --button-007-ease-focus: cubic-bezier(0.32, 0.72, 0, 1);
}
[data-wf--button--variant="dark-blue"],
[data-wf--button-link--variant="dark-blue"] {
  --button-007-color: var(--white);
  --button-007-color-background: var(--dark-blue);
  --button-007-hover-color: var(--white);
  --button-007-hover-color-background: var(--ink-black);
}
[data-wf--button--variant="light-silver"],
[data-wf--button-link--variant="light-silver"] {
  --button-007-color: var(--ink-black);
  --button-007-color-background: var(--light-silver);
  --button-007-hover-color: var(--white);
  --button-007-hover-color-background: var(--dark-blue);
}
[data-wf--button--variant="white"],
[data-wf--button-link--variant="white"] {
  --button-007-color: var(--ink-black);
  --button-007-color-background: var(--white);
  --button-007-hover-color: var(--white);
  --button-007-hover-color-background: var(--dark-blue);
}
[data-wf--button--variant="link-only"],
[data-wf--button-link--variant="link-only"] {
  --button-007-color: currentColor;
  --button-007-color-background: transparent;
  --button-007-hover-color: var(--dark-blue);
  --button-007-hover-color-background: var(--light-silver);
  --button-007-color-focus: transparent;
  --button-007-border-radius: 0.25em;
  --button-007-padding: 0.25em 0.5em;
  --button-007-focus-inset: -0.125em;
  --button-007-overflow: visible;
}  
@media (hover: none) and (pointer: coarse) {
  :root {
    --button-007-click-scale: 1.045 1.075;
  }
  .button-007__text.is--hover,
  .button-007__svg,
  .button-007__svg-overlay,
  .button-007__svg-object {
    display: none !important;
  }
  .button-007__text.is--default {
    display: block;
    position: relative;
    z-index: 2;
  }
  .button-007__inner {
    overflow: hidden;
  }
}
.button-007 {
  --button-007-stroke-width: 60;
  -webkit-tap-highlight-color: transparent;
  transition: scale 0.15s var(--button-007-ease-click);
}
.button-007:is(:focus-visible)::after {
  box-shadow: 0 0 0 0.125em var(--button-007-color-focus);
}
.button-007:active {
  scale: var(--button-007-click-scale);
}
.button-007::after {
  content: '';
  display: block;
  position: absolute;
  inset: var(--button-007-focus-inset);
  border-radius: var(--button-007-border-radius);
  transition: box-shadow 0.3s var(--button-007-ease-focus);
  pointer-events: none;
  z-index: 1;
}
.button-007__svg-overlay path,
.button-007__svg path {
  transform-box: fill-box;
  transform-origin: center;
  transform: scale(1.25);
}
</style>
